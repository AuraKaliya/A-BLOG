---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import LinkCard from "../components/LinkCard.astro";
import PageHero from "../components/PageHero.astro";
import { linkKindLabels } from "../config/taxonomy";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedLinks } from "../lib/content";
import { buildBreadcrumbStructuredData, buildCollectionPageStructuredData } from "../lib/seo";

const links = await getPublishedLinks();
const kinds = Object.entries(linkKindLabels).filter(([kind]) => links.some((entry) => entry.data.kind === kind));
const feedCount = links.filter((entry) => entry.data.feedUrl).length;
const topicCount = new Set(links.flatMap((entry) => entry.data.topics)).size;
const structuredData = [
  buildBreadcrumbStructuredData([
    { name: "首页", path: "/" },
    { name: "收藏", path: "/links" },
  ]),
  buildCollectionPageStructuredData({
    title: "收藏",
    description: "友链、推荐阅读、工具、资料与持续提供灵感的站点。",
    path: "/links",
    itemCount: links.length,
  }),
];
---

<BaseLayout
  title="收藏"
  description="友链、推荐阅读、工具、资料与持续提供灵感的站点。"
  image="/og/page/links.svg"
  robots={links.length > 0 ? "index,follow" : "noindex,follow"}
  structuredData={structuredData}
>
  <main class="page-main">
    <PageHero title="收藏" description="这里收录值得再次访问的阅读、工具、资料与创作来源。" />

    <section class="archive-section section-dark">
      <div class="container archive-list" data-link-filter-root>
        <Breadcrumbs items={[{ label: "首页", href: "/" }, { label: "收藏" }]} />

        {links.length > 0 ? <>
        <div class="link-command-panel">
          <div>
            <span class="eyebrow">收藏</span>
            <strong data-link-filter-summary>正在显示全部 {links.length} 项收藏</strong>
            <p>{feedCount} 项提供 RSS，当前关联 {topicCount} 个主题。</p>
          </div>
          <div class="search-filter-row" role="group" aria-label="收藏类型筛选">
            <button class="filter-chip active" type="button" data-link-filter="all" aria-pressed="true">全部 {links.length}</button>
            {
              kinds.map(([kind, label]) => (
                <button class="filter-chip" type="button" data-link-filter={kind} aria-pressed="false">
                  {label} {links.filter((entry) => entry.data.kind === kind).length}
                </button>
              ))
            }
          </div>
        </div>

        <div class="link-directory-grid">{links.map((entry) => <LinkCard entry={entry} anchored />)}</div>

        <section class="link-exchange-panel">
          <div>
            <span class="eyebrow">友链</span>
            <h2>友链交换信息</h2>
            <p>友链只记录已经建立持续往来的站点，其他内容会按照阅读、工具或资料分类。</p>
          </div>
          <dl>
            <div><dt>名称</dt><dd>{siteConfig.title}</dd></div>
            <div><dt>地址</dt><dd><a href={siteConfig.url}>{siteConfig.url}</a></dd></div>
            <div><dt>简介</dt><dd>{siteConfig.description}</dd></div>
            <div><dt>订阅</dt><dd><a href="/rss.xml">{new URL("/rss.xml", siteConfig.url).toString()}</a></dd></div>
          </dl>
        </section>
        </> : <EmptyState title="还没有公开收藏" description="当前暂无可浏览条目。" />}
      </div>
    </section>
  </main>
</BaseLayout>
