---
import ArchivePageLayout from "../../components/ArchivePageLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPostsBySection } from "../../lib/content";

const posts = await getPostsBySection("writings");
---

<BaseLayout title="文字" description="随笔、观察、阶段复盘与还在形成中的想法。" image="/og/page/writings.svg">
  <ArchivePageLayout
    title="文字"
    description="这里收录不以解决技术问题为唯一目标的文字：随笔、观察、创作片段与尚未完成的判断。"
    breadcrumbs={[{ label: "门户", href: "/" }, { label: "文字" }]}
  >
    {
      posts.length > 0 ? (
        posts.map((post) => <ArticleCard post={post} />)
      ) : (
        <EmptyState title="还没有公开文字" description="为文章设置 section: writings 后，它会出现在这里。" />
      )
    }
  </ArchivePageLayout>
</BaseLayout>
