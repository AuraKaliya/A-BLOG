---
import ArchivePageLayout from "../../components/ArchivePageLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import IconSymbol from "../../components/IconSymbol.astro";
import ResourceArticleCard from "../../components/ResourceArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllResourceArticleTags, getAllResourceArticles } from "../../lib/articles";

const [articles, tags] = await Promise.all([getAllResourceArticles(), getAllResourceArticleTags()]);
---

<BaseLayout title="文字" description="随笔、创作笔记与技术实践。" image="/og/page/writings.svg" robots={articles.length > 0 ? "index,follow" : "noindex,follow"}>
  <ArchivePageLayout
    title="文字"
    description="随笔、创作笔记与技术实践。"
    breadcrumbs={[{ label: "首页", href: "/" }, { label: "文字" }]}
  >
    <div class="article-command-panel" slot="before" data-article-controls hidden={articles.length === 0}>
      <div class="article-tag-filter" aria-label="标签筛选">
        <button type="button" data-article-tag="all" aria-pressed="true"><span>全部档案</span><small>{articles.length}</small></button>
        {tags.map((tag) => <button type="button" data-article-tag={tag.name} aria-pressed="false" title={tag.name}><span>{tag.name}</span><small>{tag.count}</small></button>)}
      </div>
      <div class="article-view-switch" aria-label="展示方式">
        <button type="button" data-article-view="timeline" aria-pressed="true">
          <IconSymbol name="history" />
          <span>时间轴</span>
        </button>
        <button type="button" data-article-view="grid" aria-pressed="false">
          <IconSymbol name="grid" />
          <span>网格</span>
        </button>
      </div>
    </div>

    <div class="resource-article-collection view-timeline" data-article-collection hidden={articles.length === 0}>
      {articles.map((article, index) => <ResourceArticleCard article={article} timelineSide={index % 2 === 0 ? "left" : "right"} />)}
    </div>
    <div data-article-empty hidden={articles.length > 0}>
      <EmptyState title="还没有公开文字" description="当前暂无可阅读内容。" />
    </div>
  </ArchivePageLayout>

  <script is:inline>
    (() => {
      const collection = document.querySelector("[data-article-collection]");
      const controls = document.querySelector("[data-article-controls]");
      if (!collection || !controls) return;

      const params = new URLSearchParams(window.location.search);
      let currentView = params.get("view") === "grid" ? "grid" : "timeline";
      let currentTag = params.get("tag") || "all";
      const cards = [...collection.querySelectorAll("[data-article-card]")];

      const setUrlState = () => {
        const next = new URLSearchParams();
        if (currentView !== "timeline") next.set("view", currentView);
        if (currentTag !== "all") next.set("tag", currentTag);
        const query = next.toString();
        window.history.replaceState({}, "", `${window.location.pathname}${query ? `?${query}` : ""}`);
      };

      const applyState = () => {
        collection.classList.toggle("view-grid", currentView === "grid");
        collection.classList.toggle("view-timeline", currentView === "timeline");
        controls.querySelectorAll("[data-article-view]").forEach((button) => {
          button.setAttribute("aria-pressed", button.dataset.articleView === currentView ? "true" : "false");
        });
        controls.querySelectorAll("[data-article-tag]").forEach((button) => {
          button.setAttribute("aria-pressed", button.dataset.articleTag === currentTag ? "true" : "false");
        });
        cards.forEach((card) => {
          const tags = (card.dataset.articleTags || "").split(",").filter(Boolean);
          card.hidden = currentTag !== "all" && !tags.includes(currentTag);
        });
        setUrlState();
      };

      controls.addEventListener("click", (event) => {
        const target = event.target.closest("button");
        if (!target) return;
        if (target.dataset.articleView) currentView = target.dataset.articleView;
        if (target.dataset.articleTag) currentTag = target.dataset.articleTag;
        applyState();
      });

      collection.addEventListener("click", (event) => {
        const target = event.target.closest("[data-article-tag-jump]");
        if (!target) return;
        currentTag = target.dataset.articleTagJump;
        applyState();
      });

      const slugs = cards.map((card) => card.dataset.articleSlug).filter(Boolean);
      if (slugs.length > 0) {
        fetch(`/api/articles/views/?slugs=${encodeURIComponent(slugs.join(","))}`)
          .then((response) => (response.ok ? response.json() : Promise.reject()))
          .then((payload) => {
            document.querySelectorAll("[data-article-view-count]").forEach((node) => {
              const slug = node.getAttribute("data-article-view-count");
              node.textContent = String(payload.views?.[slug] ?? 0);
            });
          })
          .catch(() => {});
      }

      applyState();
    })();
  </script>
</BaseLayout>
