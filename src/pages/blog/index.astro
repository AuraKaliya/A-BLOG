---
import ArchiveFilters from "../../components/ArchiveFilters.astro";
import ArchivePageLayout from "../../components/ArchivePageLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllBlogCategories, getAllBlogSeries, getAllBlogTags, getPublishedPosts, getTopicDefinitions } from "../../lib/content";
import { paginate } from "../../lib/pagination";
import Pagination from "../../components/Pagination.astro";

const [posts, categories, seriesList, tags, topics] = await Promise.all([
  getPublishedPosts(),
  getAllBlogCategories(),
  getAllBlogSeries(),
  getAllBlogTags(),
  getTopicDefinitions(),
]);
const paginated = paginate(posts, 1, 6, "/blog");
const filterGroups = [
  {
    title: "Categories",
    items: categories.map((category) => ({ label: category, href: `/blog/categories/${category}` })),
  },
  {
    title: "Series",
    items: seriesList.map((series) => ({ label: series, href: `/blog/series/${series}` })),
  },
  {
    title: "Topics",
    items: topics.map((topic) => ({ label: topic.data.title, href: `/blog/topics/${topic.id}` })),
  },
  {
    title: "Tags",
    items: tags.map((tag) => ({ label: tag, href: `/blog/tags/${tag}` })),
  },
];
---

<BaseLayout title="博客" description="技术笔记、产品观察和长期写作归档。" image="/og/page/blog.svg">
  <ArchivePageLayout title="博客" description="把技术、产品、阅读和阶段性复盘沉淀成可以长期回看的文本。">
    <ArchiveFilters slot="before" groups={filterGroups} />

    {
      posts.length > 0 ? (
        paginated.items.map((post) => <ArticleCard post={post} />)
      ) : (
        <EmptyState title="还没有公开文章" description="添加 Markdown 内容后，这里会自动生成归档列表。" />
      )
    }

    <Pagination slot="after" page={paginated.page} />
  </ArchivePageLayout>
</BaseLayout>
