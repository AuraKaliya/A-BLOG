---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWorldEntriesByKind } from "../../lib/content";

const events = (await getWorldEntriesByKind("event")).sort((a, b) => (b.data.eventDate ?? "").localeCompare(a.data.eventDate ?? ""));
---

<BaseLayout title="世界时间线" description="按虚构时间整理世界档案中的事件。" image="/og/page/world.svg" robots={events.length > 0 ? "index,follow" : "noindex,follow"}>
  <main class="page-main">
    <PageHero title="世界时间线" description="事件条目按设定内日期排列；它们记录世界如何变化，而不只是何时写成。" />
    <section class="archive-section world-archive-section">
      <div class="container archive-list">
        <Breadcrumbs items={[{ label: "首页", href: "/" }, { label: "世界档案", href: "/world" }, { label: "时间线" }]} />
        {
          events.length > 0 ? (
            <div class="timeline">
              {events.map((event) => (
                <article class="timeline-entry">
                  <div class="timeline-date">{event.data.eventDate ?? event.data.era ?? "日期未定"}</div>
                  <div>
                    <span class="eyebrow">事件</span>
                    <h2><a href={`/world/${event.slug}`}>{event.data.title}</a></h2>
                    <p>{event.data.description}</p>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <EmptyState title="时间线上还没有公开事件" description="当前暂无事件条目。" />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
