---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAboutPageData } from "../lib/content";
import { siteConfig } from "../config/site";
import SectionHeading from "../components/SectionHeading.astro";
import SocialCard from "../components/SocialCard.astro";

const aboutPage = await getAboutPageData();
const about = aboutPage.data;
---

<BaseLayout title={about.title} description={about.description} image="/og/page/about.svg">
  <main class="page-main">
    <section class="page-hero container">
      <h1>{about.title}</h1>
      <p>{about.description}</p>
    </section>

    <section class="about-section section-dark">
      <div class="container about-grid">
        <article class="about-story">
          <h3>{about.intro.title}</h3>
          <p>{about.intro.description}</p>
        </article>
        <div class="stats-grid" id="focus">
          {about.focusAreas.map((item, index) => <article><strong>{String(index + 1).padStart(2, "0")}</strong><span>{item}</span></article>)}
        </div>
      </div>
    </section>

    <section class="support-section section-mid" id="stack">
      <div class="container support-layout">
        <div class="support-panel">
          {
            about.stackCards.map((card) => (
              <article class:list={["support-card", { primary: card.featured }]}>
                {card.label && <span class="eyebrow">{card.label}</span>}
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </article>
            ))
          }
        </div>

        <div class="support-form static-panel" id="contact">
          <span class="eyebrow">Contact</span>
          <h3>联系方式</h3>
          <label>
            <span>{about.contact.emailLabel}</span>
            <input type="text" value={siteConfig.author.email} readonly />
          </label>
          <label>
            <span>{about.contact.githubLabel}</span>
            <input type="text" value={siteConfig.author.github.replace("https://", "")} readonly />
          </label>
          <label>
            <span>{about.contact.socialLabel}</span>
            <input type="text" value={siteConfig.author.social} readonly />
          </label>
          <a class="primary-cta submit" href={`mailto:${siteConfig.author.email}`}>{about.contact.ctaLabel}</a>
        </div>
      </div>
    </section>

    <section class="archive-section section-dark" id="socials">
      <div class="container archive-list">
        <SectionHeading
          eyebrow="Find Me"
          title="在哪里可以找到我"
          description="不同入口承载不同类型的交流：代码、订阅和较完整的联系各自有合适的位置。"
        />
        <div class="social-grid">
          {about.socialCards.map((card) => <SocialCard {...card} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
