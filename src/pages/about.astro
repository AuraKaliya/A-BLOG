---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAboutPageData } from "../lib/content";
import { siteConfig } from "../config/site";
import SectionHeading from "../components/SectionHeading.astro";
import SocialCard from "../components/SocialCard.astro";

const aboutPage = await getAboutPageData();
const about = aboutPage.data;
const contactFields = [
  { label: about.contact.emailLabel, value: siteConfig.author.email },
  { label: about.contact.githubLabel, value: siteConfig.author.github.replace("https://", "") },
  { label: about.contact.socialLabel, value: siteConfig.author.social },
].filter((item) => item.value.trim());
---

<BaseLayout title={about.title} description={about.description} image="/og/page/about.svg">
  <main class="page-main">
    <section class="page-hero container">
      <h1>{about.title}</h1>
      <p>{about.description}</p>
    </section>

    <section class="about-section section-dark" id="about">
      <div class:list={["container", "about-grid", { "single-column": about.focusAreas.length === 0 }]}>
        <article class="about-story">
          <h3>{about.intro.title}</h3>
          <p>{about.intro.description}</p>
        </article>
        {about.focusAreas.length > 0 && <div class="stats-grid">{about.focusAreas.map((item, index) => <article><strong>{String(index + 1).padStart(2, "0")}</strong><span>{item}</span></article>)}</div>}
      </div>
    </section>

    <section class="support-section section-mid" id="focus">
      <div class:list={["container", "support-layout", { "single-column": contactFields.length === 0 }]}>
        <div class="archive-list">
          <SectionHeading eyebrow="创作方向" title="我在做什么" description="目前的创作核心是幻想世界项目 Dreath。" />
          <div class="support-panel">
            {
              about.stackCards.map((card) => (
                <article id={card.title === "关于署名" ? "identity" : undefined} class:list={["support-card", { primary: card.featured }]}>
                  {card.label && <span class="eyebrow">{card.label}</span>}
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                </article>
              ))
            }
          </div>
        </div>

        {contactFields.length > 0 && <div class="support-form static-panel" id="contact">
          <span class="eyebrow">联系</span>
          <h3>联系方式</h3>
          {contactFields.map((item) => <label><span>{item.label}</span><input type="text" value={item.value} readonly /></label>)}
          {siteConfig.author.email && <a class="primary-cta submit" href={`mailto:${siteConfig.author.email}`}>{about.contact.ctaLabel}</a>}
        </div>}
      </div>
    </section>

    {about.socialCards.length > 0 && <section class="archive-section section-dark" id="socials">
      <div class="container archive-list">
        <SectionHeading
          eyebrow="站外链接"
          title="可以找到我的地方"
          description="当前可用的站外主页。"
        />
        <div class="social-grid">
          {about.socialCards.map((card) => <SocialCard {...card} />)}
        </div>
      </div>
    </section>}
  </main>
</BaseLayout>
