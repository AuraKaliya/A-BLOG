---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLabPageData, getLabWorks } from "../lib/content";

const [labPage, labWorks] = await Promise.all([getLabPageData(), getLabWorks()]);
const lab = labPage.data;
---

<BaseLayout title={lab.title} description={lab.description} image="/og/page/lab.svg">
  <main class="page-main">
    <PageHero title={lab.title} description="这里承接还不一定成熟、但值得被记录和继续打磨的实验型产出。" />

    <section class="support-section section-mid">
      <div class="container archive-list">
        <Breadcrumbs items={[{ label: "门户", href: "/" }, { label: "实验室" }]} />
        <SectionHeading
          eyebrow="Lab"
          title={lab.intro.title}
          description={lab.intro.description}
        />

        <div class="support-panel lab-panel">
          {
            lab.cards.map((card) => (
              <article class:list={["support-card", { primary: card.featured }]}>
                {card.label && <span class="eyebrow">{card.label}</span>}
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                {card.href && card.actionLabel && <a href={card.href} class="text-link">{card.actionLabel}</a>}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="archive-section section-dark">
      <div class="container archive-list">
        <SectionHeading
          eyebrow="Entries"
          title="实验条目"
          description="来自 works 内容集合中 category 为 experiment 或状态为 concept 的条目。"
        />
        {
          labWorks.length > 0 ? (
            <div class="work-grid">{labWorks.map((work) => <WorkCard work={work} />)}</div>
          ) : (
            <EmptyState title="还没有实验条目" description="添加 experiment 类型的作品后，这里会自动生成实验索引。" href="/works" actionLabel="返回作品集" />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
