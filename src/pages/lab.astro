---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLabPageData, getLabWorks } from "../lib/content";

const [labPage, labWorks] = await Promise.all([getLabPageData(), getLabWorks()]);
const lab = labPage.data;
---

<BaseLayout title={lab.title} description={lab.description} image="/og/page/lab.svg">
  <main class="page-main">
    <PageHero title={lab.title} description={lab.description} />

    {
      lab.cards.length > 0 && (
        <section class="support-section section-mid">
          <div class="container archive-list">
            <Breadcrumbs items={[{ label: "门户", href: "/" }, { label: "实验室" }]} />
            <SectionHeading eyebrow="实验室" title={lab.intro.title} description={lab.intro.description} />
            <div class="support-panel lab-panel">
              {lab.cards.map((card) => (
                <article class:list={["support-card", { primary: card.featured }]}>
                  {card.label && <span class="eyebrow">{card.label}</span>}
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                  {card.href && card.actionLabel && <a href={card.href} class="text-link">{card.actionLabel}</a>}
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="archive-section section-dark">
      <div class="container archive-list">
        <SectionHeading
          eyebrow="实验条目"
          title="实验条目"
          description={lab.intro.description}
        />
        {
          labWorks.length > 0 ? (
            <div class="work-grid">{labWorks.map((work) => <WorkCard work={work} />)}</div>
          ) : (
            <EmptyState title="还没有公开实验" description="当前暂无可展示的实验。" href="/works" actionLabel="返回作品" />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
