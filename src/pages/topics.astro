---
import ArticleCard from "../components/ArticleCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WorkCard from "../components/WorkCard.astro";
import WorldCard from "../components/WorldCard.astro";
import NoteCard from "../components/NoteCard.astro";
import LinkCard from "../components/LinkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllBlogCategories, getAllBlogTags, getTopicSummaries } from "../lib/content";
import { buildBreadcrumbStructuredData, buildTopicSummaryStructuredData } from "../lib/seo";

const [topics, categories, tags] = await Promise.all([getTopicSummaries(), getAllBlogCategories(), getAllBlogTags()]);
const structuredData = [
  buildBreadcrumbStructuredData([
    { name: "门户", path: "/" },
    { name: "主题", path: "/topics" },
  ]),
  buildTopicSummaryStructuredData(topics),
];
---

<BaseLayout
  title="主题"
  description="把博客、作品和实验按照长期关注方向重新组织。"
  image="/og/page/topics.svg"
  keywords={topics.flatMap((topic) => topic.keywords)}
  structuredData={structuredData}
>
  <main class="page-main">
    <PageHero title="主题" description="按照长期关注方向，重新浏览文章、随记、收藏与其他公开内容。" />

    <section class="archive-section section-dark">
      <div class="container archive-list">
        <Breadcrumbs items={[{ label: "门户", href: "/" }, { label: "主题" }]} />

        {topics.length > 0 ? <>
        <div class="topic-map-link-panel">
          <div>
            <span class="eyebrow">内容关系</span>
            <strong>查看内容之间的直接关系</strong>
            <p>关系图会同时展示共享主题和彼此引用的内容。</p>
          </div>
          <a class="primary-cta" href="/map">打开内容关系</a>
        </div>

        <div class="topic-overview">
          {
            topics.map((topic) => (
              <a class:list={["topic-tile", `accent-${topic.accent}`]} href={`#${topic.id}`}>
                <span>{topic.posts.length + topic.works.length + topic.worlds.length + topic.notes.length + topic.links.length}</span>
                <strong>{topic.title}</strong>
                <p>{topic.description}</p>
              </a>
            ))
          }
        </div>

        <section class="topic-taxonomy-panel">
          <SectionHeading
            eyebrow="索引"
            title="现有分类和标签"
            description="可以从文章分类和标签继续浏览。"
          />
          <div class="taxonomy-columns">
            <div>
              <h3>文章栏目</h3>
              <div class="tag-row">{categories.map((category) => <a href={`/blog/categories/${category}`}>{category}</a>)}</div>
            </div>
            <div>
              <h3>文章标签</h3>
              <div class="tag-row">{tags.map((tag) => <a href={`/blog/tags/${tag}`}>{tag}</a>)}</div>
            </div>
          </div>
        </section>

        {
          topics.map((topic) => (
            <section class="topic-section" id={topic.id}>
              <SectionHeading
                eyebrow={topic.title}
                title={`${topic.title}主题`}
                description={`${topic.description} 当前关联 ${topic.posts.length} 篇文章、${topic.works.length} 个作品、${topic.worlds.length} 份世界档案、${topic.notes.length} 条随记、${topic.links.length} 项收藏。`}
              />
              <div class="topic-keywords tag-row">{topic.keywords.map((keyword) => <span>{keyword}</span>)}</div>
              {topic.posts.length > 0 && <div class="archive-list compact-list">{topic.posts.map((post) => <ArticleCard post={post} />)}</div>}
              {topic.works.length > 0 && <div class="work-grid">{topic.works.map((work) => <WorkCard work={work} />)}</div>}
              {topic.worlds.length > 0 && <div class="world-grid">{topic.worlds.map((entry) => <WorldCard entry={entry} />)}</div>}
              {topic.notes.length > 0 && <div class="notes-grid">{topic.notes.map((note) => <NoteCard note={note} />)}</div>}
              {topic.links.length > 0 && <div class="link-directory-grid">{topic.links.map((entry) => <LinkCard entry={entry} />)}</div>}
            </section>
          ))
        }
        </> : <EmptyState title="还没有公开主题" description="主题会随公开内容出现。" />}
      </div>
    </section>
  </main>
</BaseLayout>
