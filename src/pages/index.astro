---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomePageData, getHomepageFeed } from "../lib/content";
import IconSymbol from "../components/IconSymbol.astro";
import { siteConfig } from "../config/site";
import { workCategoryLabels, workStatusLabels } from "../config/taxonomy";

const [homePage, homepageFeed] = await Promise.all([getHomePageData(), getHomepageFeed()]);
const { posts, works, featuredWorks } = homepageFeed;
const home = homePage.data;
---

<BaseLayout
  title={home.title ?? siteConfig.title}
  description={home.description ?? siteConfig.description}
  image="/og/site.svg"
>
  <main>
    <section class="hero" id="home">
      <div class="hero-gradient"></div>
      <div class="hero-grid container">
        <div class="hero-copy">
          <h1 set:html={home.hero.title.replace(/\n/g, "<br />")}></h1>
          <p class="hero-text">{home.hero.description}</p>
          <div class="hero-actions-row">
            {
              home.hero.actions.map((action) => (
                <a class={action.variant === "secondary" ? "secondary-cta" : "primary-cta"} href={action.href}>
                  {action.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="orbital-stage">
            <div class="orbital-ring ring-a"></div>
            <div class="orbital-ring ring-b"></div>
            <div class="orbital-ring ring-c"></div>
            {
              home.hero.metrics.map((metric, index) => (
                <div class:list={["signal-card", { accent: index === 1 }]}>
                  <span class="eyebrow">{metric.eyebrow}</span>
                  <strong>{metric.value}</strong>
                  <p>{metric.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="statement-band">
      <div class="container">
        <p>
          这个站点的首版目标很明确：
          <strong>不是做复杂后台，而是先建立一个稳定、漂亮、可持续填充的公开档案。</strong>
        </p>
      </div>
    </section>

    <section class="portal-section section-dark" id="portal">
      <div class="container">
        <div class="section-heading split">
          <div>
            <span class="eyebrow">Portal</span>
            <h2>首页是个人内容的总控入口</h2>
          </div>
          <p>
            参考原型的门户卡片布局，把“博客”从唯一入口扩展为个人展示系统：写作沉淀、作品展示、实验记录和个人介绍各自有位置。
          </p>
        </div>

        <div class="portal-grid">
          {
            home.portalCards.map((card) => (
              <a class="portal-card" href={card.href}>
                <span class="portal-icon">
                  <IconSymbol name={card.icon ?? "grid"} />
                </span>
                <strong>{card.title}</strong>
                <p>{card.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="products-section section-mid" id="works">
      <div class="container">
        <div class="section-heading split">
          <div>
            <span class="eyebrow">Works</span>
            <h2>作品区保留可继续扩展的分类骨架</h2>
          </div>
          <p>
            作品不只放“完成品”。你可以把项目、研究、工具、文章系列和实验原型都纳入统一展示层。
          </p>
        </div>

        <div class="pillar-cards">
          {
            featuredWorks.map((work) => (
              <article class="pillar-card">
                <div class:list={["media-surface", work.data.category]}></div>
                <span class="eyebrow">{workCategoryLabels[work.data.category]}</span>
                <h3>{work.data.title}</h3>
                <p>{work.data.description}</p>
                <ul>
                  <li>{work.data.year}</li>
                  <li>{work.data.role}</li>
                  <li>{workStatusLabels[work.data.status]}</li>
                  {work.data.techStack.slice(0, 2).map((item) => <li>{item}</li>)}
                </ul>
                <a class="text-link" href={`/works/${work.slug}`}>查看详情</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="learn-section section-dark" id="blog">
      <div class="container">
        <div class="section-heading split">
          <div>
            <span class="eyebrow">Blog</span>
            <h2>博客保持轻量，但要成为长期资产</h2>
          </div>
          <p>每篇文章就是一个 Markdown 文件，适合稳定写作、版本管理和未来迁移。</p>
        </div>

        <div class="learn-layout">
          <article class="feature-story">
            <span class="eyebrow">Latest</span>
            <h3>{posts[0]?.data.title ?? "还没有文章"}</h3>
            <p>{posts[0]?.data.description ?? "添加 Markdown 文件后，这里会自动显示最新文章。"}</p>
            <a href={posts[0] ? `/blog/${posts[0].slug}` : "/blog"} class="text-link">阅读最新文章</a>
          </article>

          <div class="resource-column">
            <h4>最近文章</h4>
            {posts.map((post) => <a href={`/blog/${post.slug}`}>{post.data.title}</a>)}
          </div>

          <div class="resource-column">
            <h4>建议栏目</h4>
            {home.suggestedPostColumns.map((item) => <a href="/blog">{item}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="support-section section-mid" id="lab">
      <div class="container">
        <div class="section-heading split">
          <div>
            <span class="eyebrow">Lab</span>
            <h2>实验室用来承接未完全产品化的想法</h2>
          </div>
          <p>这部分是个人站很容易被忽视、但很有价值的区域：它能展示你如何思考、试错和迭代。</p>
        </div>

        <div class="support-layout">
          <div class="support-panel">
            {
              home.labCards.map((card) => (
                <article class:list={["support-card", { primary: card.featured }]}>
                  {card.label && <span class="eyebrow">{card.label}</span>}
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                  {card.href && card.actionLabel && <a href={card.href} class="text-link">{card.actionLabel}</a>}
                </article>
              ))
            }
          </div>

          <div class="support-form static-panel">
            <span class="eyebrow">Roadmap</span>
            <h3>首版之后可以继续加什么</h3>
            {
              home.roadmapItems.map((item) => (
                <label>
                  <span>{item.label}</span>
                  <input type="text" value={item.value} readonly />
                </label>
              ))
            }
            <a class="primary-cta submit" href="/about">查看个人档案</a>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section section-dark" id="about">
      <div class="container">
        <div class="section-heading split">
          <div>
            <span class="eyebrow">About</span>
            <h2>关于页承担个人站的解释权</h2>
          </div>
          <p>如果首页负责分发，关于页就负责建立信任：身份、方向、能力、联系方式都应该清楚。</p>
        </div>

        <div class="about-grid">
          <article class="about-story">
            <h3>{home.aboutStory.title}</h3>
            <p>{home.aboutStory.description}</p>
            <a class="text-link" href={home.aboutStory.href}>{home.aboutStory.actionLabel}</a>
          </article>

          <div class="stats-grid">
            <article>
              <strong>{posts.length}</strong>
              <span>首批文章</span>
            </article>
            <article>
              <strong>{works.length}</strong>
              <span>作品条目</span>
            </article>
            <article>
              <strong>MD</strong>
              <span>内容文件驱动</span>
            </article>
            <article>
              <strong>RSS</strong>
              <span>订阅能力预留</span>
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
