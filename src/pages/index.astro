---
import BaseLayout from "../layouts/BaseLayout.astro";
import IconSymbol from "../components/IconSymbol.astro";
import { siteConfig } from "../config/site";
import { getHomePageData, getHomepageFeed } from "../lib/content";
import { formatDate } from "../lib/format";
import { existsSync, statSync } from "node:fs";
import { extname, resolve, sep } from "node:path";

const [homePage, homepageFeed] = await Promise.all([
  getHomePageData(),
  getHomepageFeed(),
]);

const { recentUpdates } = homepageFeed;
const home = homePage.data;
const resourceRoot = resolve("resource");
const imageExtensions = [".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif"];
const defaultResourceImage = "/resource/default/default_image.png";
const normalizeResourceIndex = (index?: string) =>
  index
    ?.replace(/^\/?resource\//, "")
    .replace(/^\/+/, "")
    .replace(/\\/g, "/");
const toResourceUrl = (index: string) => `/resource/${index.replace(/\\/g, "/")}`;
const isResourceFile = (index: string) => {
  const resolvedPath = resolve(resourceRoot, index);
  if (!(resolvedPath === resourceRoot || resolvedPath.startsWith(`${resourceRoot}${sep}`))) return false;
  try {
    return existsSync(resolvedPath) && statSync(resolvedPath).isFile();
  } catch {
    return false;
  }
};
const findResourceImage = (index?: string) => {
  const cleanIndex = normalizeResourceIndex(index);
  const candidates = cleanIndex
    ? extname(cleanIndex)
      ? [cleanIndex]
      : imageExtensions.map((extension) => `${cleanIndex}${extension}`)
    : [];
  const match = candidates.find(isResourceFile);
  return match ? toResourceUrl(match) : defaultResourceImage;
};
const profileImage = findResourceImage(home.profile.imageIndex);
const recentStatusImage = findResourceImage(home.recentStatus.imageIndex);
const updateItems = recentUpdates.filter((update) => update.kind !== "changelog" && update.kind !== "link").slice(0, 5);
---

<BaseLayout
  title={home.title ?? siteConfig.title}
  description={home.description ?? siteConfig.description}
  image="/og/site.svg"
>
  <main class="home-main" data-cms-home>
    <section class="home-screen home-entry-screen" id="home" data-home-screen="entry">
      <div class="container home-entry-grid">
        <article class="profile-card">
          <div class="profile-card-header">
            <div class:list={["profile-avatar", { "has-image": Boolean(profileImage) }]}>
              {
                profileImage ? (
                  <img
                    src={profileImage}
                    alt={home.profile.imageAlt ?? home.profile.name}
                    loading="eager"
                    style={`object-position: ${home.profile.imagePosition ?? "50% 50%"}`}
                    data-home-profile-image
                  />
                ) : (
                  <span aria-hidden="true">{home.profile.name.slice(0, 1)}</span>
                )
              }
            </div>
            <div>
              <span class="eyebrow" data-home-profile-eyebrow>{home.profile.eyebrow}</span>
              <h1 data-home-profile-name>{home.profile.name}</h1>
              <p data-home-profile-role>{home.profile.role}</p>
            </div>
          </div>

          <div class="profile-status">
            <span data-home-profile-status>{home.profile.status}</span>
            <strong data-home-profile-location hidden={!home.profile.location}>{home.profile.location}</strong>
          </div>

          <p class="profile-bio" data-home-profile-bio>{home.profile.bio}</p>

          <div class="profile-tags" data-home-profile-tags>
            {home.profile.tags.map((tag) => <span>{tag}</span>)}
          </div>

          <div class="profile-actions" data-home-profile-links>
            {home.profile.links.map((link) => <a class="text-link" href={link.href}>{link.label}</a>)}
          </div>
        </article>

        <div class="home-side-stack">
          <article class="recent-status-card">
            <div class="recent-status-image">
              {recentStatusImage && (
                <img
                  src={recentStatusImage}
                  alt={home.recentStatus.imageAlt ?? home.recentStatus.title}
                  loading="eager"
                  style={`object-position: ${home.recentStatus.imagePosition ?? "50% 50%"}`}
                  data-home-recent-image
                />
              )}
            </div>
            <div class="recent-status-copy">
              <span class="eyebrow" data-home-recent-eyebrow>{home.recentStatus.eyebrow}</span>
              <h2 data-home-recent-title>{home.recentStatus.title}</h2>
              <p data-home-recent-description>{home.recentStatus.description}</p>
              {home.recentStatus.href && <a class="text-link" href={home.recentStatus.href}>查看详情</a>}
            </div>
          </article>

          <article class="random-explore-card">
            <span class="eyebrow" data-home-random-eyebrow>{home.randomExplore.eyebrow}</span>
            <h2 data-home-random-title>{home.randomExplore.title}</h2>
            <p data-home-random-description>{home.randomExplore.description}</p>
            <button class="primary-cta home-random-button random-entry-button" type="button" data-random-entry>
              <IconSymbol name="spark" />
              <span data-home-random-action>{home.randomExplore.actionLabel}</span>
            </button>
          </article>
        </div>
      </div>
    </section>

    <section class="home-screen home-intro-screen" id="intro" data-home-screen="intro">
      <div class="container home-intro-layout">
        <div class="home-intro-copy">
          <span class="eyebrow" data-home-intro-eyebrow>{home.intro.eyebrow}</span>
          <h2 data-home-intro-title>
            {home.intro.title.split("\n").map((line) => <span>{line}</span>)}
          </h2>
          <p data-home-intro-lead>{home.intro.lead}</p>
        </div>

        <div class="home-highlight-list" data-home-highlights>
          {
            home.intro.highlights.map((highlight, index) => (
              <a class="home-highlight-item" href={highlight.href}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{highlight.keyword}</strong>
                <h3>{highlight.title}</h3>
                <p>{highlight.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-screen home-status-screen" id="signals" data-home-screen="signals">
      <div class="container">
        <div class="home-status-heading">
          <span class="eyebrow">最近公开</span>
          <h2>最近更新</h2>
          <p>从最新公开的内容开始浏览。</p>
        </div>

        <div class="home-status-grid">
          <article class="home-status-panel latest-panel">
            <div class="home-panel-heading">
              <h3>内容更新</h3>
              <a class="text-link" href="/archive">查看归档</a>
            </div>
            <div class="home-update-list">
              {
                updateItems.map((update) => (
                  <a class="home-update-item" href={update.href}>
                    <time datetime={update.date.toISOString()}>{formatDate(update.date)}</time>
                    <span>{update.type}</span>
                    <strong>{update.title}</strong>
                    <p>{update.description}</p>
                  </a>
                ))
              }
            </div>
          </article>

          <article class="home-status-panel timeline-panel home-focus-panel">
            <div class="home-panel-heading">
              <h3>正在创作</h3>
              <a class="text-link" href="/now">查看现在</a>
            </div>
            <div class="home-focus-copy">
              <span class="eyebrow">当前创作</span>
              <h3>Dreath 世界观</h3>
              <p>{home.recentStatus.description}</p>
              <a class="secondary-cta" href="/world">进入世界档案</a>
            </div>
          </article>

          <article class="home-status-panel stats-panel home-continue-panel">
            <div class="home-panel-heading">
              <h3>继续浏览</h3>
            </div>
            <div class="home-continue-list">
              <a href="/writings"><strong>文字</strong><span>随笔与技术记录</span></a>
              <a href="/notes"><strong>随记</strong><span>状态、片段与分享</span></a>
              <a href="/links"><strong>收藏</strong><span>阅读、工具与资料</span></a>
              <a href="/topics"><strong>主题</strong><span>按长期关注方向浏览</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
