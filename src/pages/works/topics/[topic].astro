---
import ArchivePageLayout from "../../../components/ArchivePageLayout.astro";
import EmptyState from "../../../components/EmptyState.astro";
import WorkCard from "../../../components/WorkCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTopicDefinitions, getWorksByTopic, type TopicEntry } from "../../../lib/content";
import { buildBreadcrumbStructuredData, buildCollectionPageStructuredData } from "../../../lib/seo";

export async function getStaticPaths() {
  const topics = await getTopicDefinitions();

  return topics.map((topic) => ({
    params: { topic: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props as { topic: TopicEntry };
const works = await getWorksByTopic(topic.id);
const structuredData = [
  buildBreadcrumbStructuredData([
    { name: "门户", path: "/" },
    { name: "作品", path: "/works" },
    { name: topic.data.title, path: `/works/topics/${topic.id}` },
  ]),
  buildCollectionPageStructuredData({
    title: `主题：${topic.data.title}`,
    description: topic.data.description,
    path: `/works/topics/${topic.id}`,
    itemCount: works.length,
  }),
];
---

<BaseLayout
  title={`主题：${topic.data.title}`}
  description={`归档所有属于 ${topic.data.title} 主题的作品。`}
  image={`/og/topics/${topic.id}.svg`}
  keywords={topic.data.keywords}
  structuredData={structuredData}
>
  <ArchivePageLayout
    title={`主题：${topic.data.title}`}
    description={topic.data.description}
    sectionTone="section-mid"
    breadcrumbs={[{ label: "作品", href: "/works" }, { label: `主题：${topic.data.title}` }]}
  >
    {
      works.length > 0 ? (
        <div class="work-grid">{works.map((work) => <WorkCard work={work} />)}</div>
      ) : (
        <EmptyState title="这个主题下还没有作品" description="后续为作品补充主题后，这里会自动聚合对应内容。" />
      )
    }
  </ArchivePageLayout>
</BaseLayout>
