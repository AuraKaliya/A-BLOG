---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  split?: boolean;
}

const { eyebrow, title, description, split = true } = Astro.props;
---

<div class:list={["section-heading", { split }]}>
  <div>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
  </div>
  {description && <p>{description}</p>}
</div>
