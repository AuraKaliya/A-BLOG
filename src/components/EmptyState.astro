---
interface Props {
  title: string;
  description: string;
  href?: string;
  actionLabel?: string;
}

const { title, description, href, actionLabel } = Astro.props;
---

<article class="archive-item empty-state">
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
    {href && actionLabel && <a class="text-link" href={href}>{actionLabel}</a>}
  </div>
</article>
