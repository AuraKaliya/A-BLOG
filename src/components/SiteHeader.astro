---
import { aboutMenuLinks, mainNav } from "../config/navigation";
import { siteConfig } from "../config/site";
import IconSymbol from "./IconSymbol.astro";

const pathname = Astro.url.pathname;
const isActivePath = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname === path || pathname.startsWith(`${path}/`);
};
---

<header class="site-header" id="top">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="返回首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" role="img">
          <path d="M12 44 28 12h12l-9 18h17L28 58l7-24H18z"></path>
        </svg>
      </span>
      <span class="brand-copy">
        <strong>{siteConfig.name}</strong>
        <span>{siteConfig.tagline}</span>
      </span>
    </a>

    <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="切换导航">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-group" id="site-nav">
      <nav class="site-nav" aria-label="主导航">
        {
          mainNav.map((item) => (
            <a class:list={["nav-link", { active: isActivePath(item.match) }]} href={item.href} aria-current={isActivePath(item.match) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }

        <div class="nav-item has-menu" data-menu-root>
          <button
            class:list={["nav-trigger", { active: isActivePath("/about") }]}
            type="button"
            aria-expanded="false"
            aria-controls="menu-about"
            data-menu-trigger="about"
          >
            关于
            <span class="nav-chevron" aria-hidden="true"></span>
          </button>

          <div class="mega-menu" id="menu-about" data-menu="about">
            <div class="mega-shell">
              <div class="menu-kicker">
                <span class="eyebrow">关于</span>
                <h3>Aura Kaliye 的创作与记录</h3>
                <p>了解我的创作方向、署名和最近状态。</p>
              </div>

              <div class="menu-columns three-up">
                {
                  aboutMenuLinks.map((column) => (
                    <div class="menu-column">
                      <h4>{column.title}</h4>
                      {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
                    </div>
                  ))
                }
                <article class="featured-menu-card">
                  <span class="eyebrow">当前项目</span>
                  <h4>Dreath</h4>
                  <p>一个围绕人物、地点、事件与规则展开的幻想世界项目。</p>
                  <a href="/now" class="text-link">查看当前状态</a>
                </article>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <div class="nav-actions">
        <button class="utility-button" type="button" aria-label="切换明暗主题" aria-pressed="false" data-theme-toggle>
          <IconSymbol name="spark" />
        </button>
        <a class="utility-button" href="/rss.xml" aria-label="RSS">
          <IconSymbol name="rss" />
        </a>
        <a class:list={["utility-chip", { active: isActivePath("/search") }]} href="/search" aria-label="站内搜索">
          <IconSymbol name="nodes" />
          <span>搜索</span>
        </a>
      </div>
    </div>
  </div>
</header>
