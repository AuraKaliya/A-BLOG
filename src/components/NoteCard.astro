---
import type { NoteEntry } from "../lib/content";
import { noteKindLabels } from "../config/taxonomy";
import { formatDate } from "../lib/format";

interface Props {
  note: NoteEntry;
}

const { note } = Astro.props;
---

<article class:list={["note-card", `note-${note.data.kind}`]} data-note-kind={note.data.kind}>
  <div class="note-card-meta">
    <span>{noteKindLabels[note.data.kind]}</span>
    <time datetime={note.data.pubDate.toISOString()}>{formatDate(note.data.pubDate)}</time>
    {note.data.mood && <span>{note.data.mood}</span>}
  </div>
  <h2><a href={`/notes/${note.slug}`}>{note.data.title}</a></h2>
  <p>{note.data.description}</p>
  {note.data.tags.length > 0 && <div class="tag-row">{note.data.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}</div>}
  <div class="note-card-actions">
    <a class="text-link" href={`/notes/${note.slug}`}>打开这条动态</a>
    {note.data.externalUrl && <a class="text-link" href={note.data.externalUrl} target="_blank" rel="noreferrer">访问分享链接</a>}
  </div>
</article>
