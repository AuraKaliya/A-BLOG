---
import type { PageInfo } from "../lib/pagination";
import { pagePath } from "../lib/pagination";

interface Props {
  page: PageInfo;
}

const { page } = Astro.props;
---

{
  page.totalPages > 1 && (
    <nav class="pagination" aria-label="分页">
      <a class:list={["pagination-control", { disabled: !page.previousPath }]} href={page.previousPath ?? "#"} aria-disabled={!page.previousPath}>
        上一页
      </a>
      <div class="pagination-pages">
        {Array.from({ length: page.totalPages }, (_, index) => {
          const itemPage = index + 1;
          const isCurrent = itemPage === page.currentPage;
          return (
            <a class:list={["pagination-page", { active: isCurrent }]} href={pagePath(page.basePath, itemPage)} aria-current={isCurrent ? "page" : undefined}>
              {itemPage}
            </a>
          );
        })}
      </div>
      <a class:list={["pagination-control", { disabled: !page.nextPath }]} href={page.nextPath ?? "#"} aria-disabled={!page.nextPath}>
        下一页
      </a>
    </nav>
  )
}
